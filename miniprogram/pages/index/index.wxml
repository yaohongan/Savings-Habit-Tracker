<!--index.wxml-->
<view class="page-container">
  <!-- 顶部氛围背景 -->
  <view class="header-bg">
    <view class="bg-circle-1"></view>
    <view class="bg-circle-2"></view>
  </view>

  <!-- 自定义透明导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-title">小简攒钱</view>
    <view class="nav-buttons">
      <view class="nav-btn" hover-class="hover-effect" bindtap="onOpenBackup">
        <text class="nav-btn-icon">💾</text>
      </view>
      <view class="nav-btn" hover-class="hover-effect" bindtap="onTapAchievements">
        <text class="nav-btn-icon">🏆</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="main-scroll" style="padding-top: {{statusBarHeight + 44}}px;">
    
    <!-- 顶部资产大字区 -->
    <view class="asset-hero">
      <view class="asset-subtitle">
        <text>我的小金库</text>
        <view class="tag-badge" wx:if="{{totalSavedDisplay !== '0.00'}}">努力变富中 💸</view>
        <view class="tag-badge" wx:else>开始你的第一笔 👇</view>
      </view>
      <view class="asset-amount">
        <text class="symbol">¥</text>
        <text class="number">{{totalSavedDisplay}}</text>
      </view>
      <view class="asset-progress" wx:if="{{totalGoalDisplay !== '0.00'}}">
        <view class="progress-track">
          <view class="progress-fill" style="width: {{overallPercent}}%;"></view>
        </view>
        <text class="progress-txt">总目标进度 {{overallPercentDisplay}}</text>
      </view>
    </view>

    <!-- 悬浮数据统计卡片 -->
    <view class="stats-floating-card" wx:if="{{goals.length > 0}}">
      <view class="stat-col">
        <text class="stat-num">{{todaySavedDisplay}}</text>
        <text class="stat-label">今日已攒(元)</text>
      </view>
      <view class="divider"></view>
      <view class="stat-col">
        <text class="stat-num">{{streakDisplay}}</text>
        <text class="stat-label">连续打卡(天)</text>
      </view>
      <view class="divider"></view>
      <view class="stat-col">
        <text class="stat-num">{{totalCheckInsDisplay}}</text>
        <text class="stat-label">累计打卡(次)</text>
      </view>
      <view class="divider"></view>
      <view class="stat-col">
        <text class="stat-num">{{doneGoalsCountDisplay}}</text>
        <text class="stat-label">已完成(个)</text>
      </view>
    </view>

    <view class="daily-focus-card" wx:if="{{goals.length > 0 && focusGoalId}}">
      <view class="daily-focus-glow"></view>
      <view class="daily-focus-top">
        <view>
          <view class="daily-focus-tag">今天先完成这一笔</view>
          <view class="daily-focus-title">{{focusGoalName}}</view>
        </view>
        <view class="daily-focus-percent">{{focusGoalPercentDisplay}}</view>
      </view>
      <view class="daily-focus-progress">
        <view class="daily-focus-progress-fill" style="width: {{focusGoalPercentDisplay}};"></view>
      </view>
      <view class="daily-focus-grid">
        <view class="daily-focus-metric">
          <text class="daily-focus-num">¥{{focusGoalSuggestedAmountDisplay}}</text>
          <text class="daily-focus-label">建议今天存</text>
        </view>
        <view class="daily-focus-metric">
          <text class="daily-focus-num">¥{{focusGoalRemainingDisplay}}</text>
          <text class="daily-focus-label">距离目标还差</text>
        </view>
      </view>
      <view class="daily-focus-meta">
        <text>已攒 ¥{{focusGoalSavedDisplay}} / 目标 ¥{{focusGoalTargetDisplay}}</text>
        <text>{{focusGoalRemainingDaysText}}</text>
      </view>
      <view class="daily-focus-tip">{{focusGoalHint}}</view>
      <view class="daily-focus-recovery" wx:if="{{recoveryPromptText}}">{{recoveryPromptText}}</view>
      <view class="daily-focus-milestone">{{focusGoalMilestoneText}}</view>
      <view class="daily-focus-actions">
        <view class="daily-focus-action" hover-class="hover-effect" bindtap="onTapCheckInWithGoal" data-id="{{focusGoalId}}">
          <text>去完成今天这笔</text>
        </view>
        <view class="daily-focus-action daily-focus-action-secondary" hover-class="hover-effect" bindtap="onRequestSavingReminder">
          <text>{{reminderStatusText}}</text>
        </view>
      </view>
    </view>

    <view class="challenge-card" wx:if="{{goals.length > 0}}">
      <view class="challenge-orbit challenge-orbit-a"></view>
      <view class="challenge-orbit challenge-orbit-b"></view>
      <view class="challenge-header">
        <view>
          <view class="challenge-kicker">365 天点亮挑战</view>
          <view class="challenge-title">{{challengeName}}</view>
        </view>
        <view class="challenge-today-badge {{challengeTodayDone ? 'challenge-today-done' : ''}}">
          {{challengeTodayStateText}}
        </view>
      </view>
      <view class="challenge-hero-row">
        <view class="challenge-number-block">
          <text class="challenge-big-number">{{challengeLitDaysDisplay}}</text>
          <text class="challenge-number-unit">/365 格</text>
        </view>
        <view class="challenge-copy">
          <text>累计点亮进度 {{challengePercentDisplay}}</text>
          <text>这面墙越满，越有截图分享的冲动。</text>
        </view>
      </view>
      <view class="challenge-progress">
        <view class="challenge-progress-fill" style="width: {{challengePercent}}%;"></view>
      </view>
      <view class="challenge-wall">
        <view
          wx:for="{{challengeDays}}"
          wx:key="key"
          class="challenge-dot {{item.levelClass}} {{item.isToday ? 'challenge-dot-today' : ''}} {{item.isFuture ? 'challenge-dot-future' : ''}}"
        ></view>
      </view>
      <view class="challenge-stats">
        <view class="challenge-stat">
          <text class="challenge-stat-num">¥{{challengeTotalAmountDisplay}}</text>
          <text class="challenge-stat-label">挑战累计攒下</text>
        </view>
        <view class="challenge-stat">
          <text class="challenge-stat-num">{{challengeElapsedDaysDisplay}} 天</text>
          <text class="challenge-stat-label">已经走过</text>
        </view>
        <view class="challenge-stat">
          <text class="challenge-stat-num">{{challengeLeftDaysDisplay}} 格</text>
          <text class="challenge-stat-label">待点亮</text>
        </view>
      </view>
      <view class="challenge-status">{{challengeStatusText}}</view>
      <view class="challenge-actions">
        <view class="challenge-action challenge-action-primary" hover-class="hover-effect" bindtap="onTapCheckInWithGoal" data-id="{{focusGoalId}}">
          <text>点亮今天</text>
        </view>
        <view class="challenge-action challenge-action-secondary" hover-class="hover-effect" bindtap="onCopyChallengeShare">
          <text>复制分享文案</text>
        </view>
      </view>
    </view>

    <view class="review-entry-card" wx:if="{{goals.length > 0}}" hover-class="hover-effect" bindtap="onToggleReviewPanel">
      <view class="review-entry-left">
        <view class="review-entry-kicker">复盘中心</view>
        <view class="review-entry-title">{{showReviewPanel ? '收起详细复盘' : '展开月历、节奏和本月小结'}}</view>
        <view class="review-entry-desc">首页先保持轻，想复盘时再看完整数据。</view>
      </view>
      <view class="review-entry-right">
        <view class="review-mini-stat">
          <text class="review-mini-num">{{calendarActiveDaysDisplay}}</text>
          <text class="review-mini-label">本月打卡</text>
        </view>
        <view class="review-toggle-icon">{{showReviewPanel ? '收起' : '展开'}}</view>
      </view>
    </view>

    <view class="review-panel" wx:if="{{goals.length > 0 && showReviewPanel}}">
    <view class="share-kit-card">
      <view class="share-kit-header">
        <view>
          <view class="share-kit-tag">分享素材中心</view>
          <view class="share-kit-title">把坚持变成能发出去的素材</view>
        </view>
      </view>
      <view class="share-kit-grid">
        <view class="share-kit-item" hover-class="hover-effect" bindtap="onCopyWeeklyReport">
          <text class="share-kit-icon">📝</text>
          <text class="share-kit-name">复制本周周报</text>
          <text class="share-kit-desc">{{weeklySummaryRangeText}} · {{weeklySummaryDaysDisplay}} 天打卡</text>
        </view>
        <view class="share-kit-item" hover-class="hover-effect" bindtap="onCopyChallengeShare">
          <text class="share-kit-icon">✨</text>
          <text class="share-kit-name">复制挑战进度</text>
          <text class="share-kit-desc">365 点亮 {{challengeLitDaysDisplay}} 格</text>
        </view>
        <view class="share-kit-item" hover-class="hover-effect" bindtap="onCopySupervisionShare">
          <text class="share-kit-icon">👀</text>
          <text class="share-kit-name">邀请朋友监督</text>
          <text class="share-kit-desc">一句话让朋友提醒你别断</text>
        </view>
      </view>
      <view class="poster-theme-box">
        <view class="poster-theme-head">
          <text>海报模板</text>
          <view class="poster-theme-generate" hover-class="hover-effect" bindtap="onGeneratePoster">生成当前模板</view>
        </view>
        <view class="poster-theme-list">
          <view
            wx:for="{{posterThemes}}"
            wx:key="key"
            class="poster-theme-chip {{posterThemeKey === item.key ? 'poster-theme-chip-active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onSelectPosterTheme"
          >
            <text class="poster-theme-name">{{item.name}}</text>
            <text class="poster-theme-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
      <view class="weekly-report-card">
        <view class="weekly-report-top">
          <view>
            <view class="weekly-report-kicker">本周复盘</view>
            <view class="weekly-report-title">{{weeklySummaryRangeText}}</view>
          </view>
          <view class="weekly-report-mood">{{weeklySummaryMoodText}}</view>
        </view>
        <view class="weekly-report-stats">
          <view>
            <text class="weekly-report-num">{{weeklySummaryDaysDisplay}}</text>
            <text class="weekly-report-label">打卡天数</text>
          </view>
          <view>
            <text class="weekly-report-num">¥{{weeklySummaryAmountDisplay}}</text>
            <text class="weekly-report-label">本周攒下</text>
          </view>
          <view>
            <text class="weekly-report-num">¥{{weeklySummaryAverageDisplay}}</text>
            <text class="weekly-report-label">日均攒下</text>
          </view>
        </view>
        <view class="weekly-report-focus">
          本周最投入：{{weeklySummaryTopGoalName}} · ¥{{weeklySummaryTopGoalAmountDisplay}}
        </view>
        <view class="weekly-report-insight">{{weeklySummaryInsight}}</view>
      </view>
    </view>

    <view class="rhythm-card">
      <view class="rhythm-header">
        <view>
          <view class="rhythm-tag">最近 28 天</view>
          <view class="rhythm-title">攒钱节奏板</view>
        </view>
        <view class="rhythm-summary">
          <text class="rhythm-summary-num">{{rhythmWeekCheckInsDisplay}}/7</text>
          <text class="rhythm-summary-label">本周打卡</text>
        </view>
      </view>
      <view class="rhythm-grid">
        <view
          wx:for="{{rhythmDays}}"
          wx:key="key"
          class="rhythm-cell {{item.levelClass}} {{item.isToday ? 'rhythm-cell-today' : ''}}"
        >
          <text class="rhythm-cell-label">{{item.label}}</text>
        </view>
      </view>
      <view class="rhythm-legend">
        <text>活跃 {{rhythmActiveDaysDisplay}} 天</text>
        <text>最近 28 天已攒 ¥{{rhythmRecentAddedDisplay}}</text>
      </view>
      <view class="rhythm-status">{{rhythmStatusText}}</view>
    </view>

    <view class="calendar-card">
      <view class="calendar-header">
        <view>
          <view class="calendar-tag">本月打卡视图</view>
          <view class="calendar-title">{{calendarMonthTitle}}</view>
        </view>
        <view class="calendar-summary">
          <text class="calendar-summary-num">{{calendarActiveDaysDisplay}} 天</text>
          <text class="calendar-summary-label">本月已打卡</text>
        </view>
      </view>
      <view class="calendar-weekdays">
        <text wx:for="{{calendarWeekdays}}" wx:key="*this" class="calendar-weekday">{{item}}</text>
      </view>
      <view class="calendar-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="key"
          class="calendar-cell {{item.levelClass}} {{item.isToday ? 'calendar-cell-today' : ''}}"
        >
          <text class="calendar-cell-label">{{item.dayLabel}}</text>
        </view>
      </view>
      <view class="calendar-legend">
        <text>本月已攒 ¥{{calendarMonthlyAddedDisplay}}</text>
        <text>最长连续 {{calendarLongestStreakDisplay}} 天</text>
      </view>
      <view class="calendar-status">{{calendarStatusText}}</view>
    </view>

    <view class="summary-card">
      <view class="summary-header">
        <view>
          <view class="summary-tag">本月小结</view>
          <view class="summary-title">这段时间你已经在变稳了</view>
        </view>
        <view class="summary-copy-btn" hover-class="hover-effect" bindtap="onCopyMonthlySummary">
          <text>复制小结</text>
        </view>
      </view>
      <view class="summary-grid">
        <view class="summary-metric">
          <text class="summary-num">{{monthlySummaryDaysDisplay}}</text>
          <text class="summary-label">本月打卡天数</text>
        </view>
        <view class="summary-metric">
          <text class="summary-num">¥{{monthlySummaryAmountDisplay}}</text>
          <text class="summary-label">本月累计攒下</text>
        </view>
        <view class="summary-metric">
          <text class="summary-num">¥{{monthlySummaryAverageDisplay}}</text>
          <text class="summary-label">单次平均存入</text>
        </view>
        <view class="summary-metric">
          <text class="summary-num">{{monthlySummaryUnlockedDisplay}}</text>
          <text class="summary-label">已解锁成就</text>
        </view>
      </view>
      <view class="summary-highlight">
        <text class="summary-highlight-title">这个月最投入的目标</text>
        <text class="summary-highlight-goal">{{monthlySummaryTopGoalName}}</text>
        <text class="summary-highlight-amount">已存入 ¥{{monthlySummaryTopGoalAmountDisplay}}</text>
      </view>
      <view class="summary-insight">{{monthlySummaryInsight}}</view>
    </view>
    </view>

    <!-- 真实攒钱剧本 -->
    <view class="script-section" wx:if="{{goals.length === 0}}">
      <view class="script-section-header">
        <view>
          <view class="script-kicker">先选一个剧本开局</view>
          <view class="script-title">不用想目标，直接开始一个真实挑战</view>
        </view>
      </view>
      <scroll-view scroll-x class="script-scroll" show-scrollbar="false">
        <view
          wx:for="{{challengeScripts}}"
          wx:key="name"
          class="script-card"
          data-index="{{index}}"
          bindtap="onUseChallengeScript"
        >
          <view class="script-icon">{{item.icon}}</view>
          <view class="script-name">{{item.name}}</view>
          <view class="script-subtitle">{{item.subtitle}}</view>
          <view class="script-meta">
            <text>¥{{item.target}}</text>
            <text>{{item.days}}天</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 热门目标一键添加 -->
    <view class="hot-goals-section" wx:if="{{goals.length === 0}}">
      <view class="section-title">热门目标一键添加</view>
      <scroll-view scroll-x class="hot-goals-scroll" show-scrollbar="false">
        <view 
          wx:for="{{hotGoalTemplates}}" 
          wx:key="name" 
          class="hot-goal-card"
          data-index="{{index}}"
          bindtap="onAddHotGoal"
        >
          <text class="hot-goal-icon">{{item.icon}}</text>
          <text class="hot-goal-name">{{item.name}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 攒钱目标区 -->
    <view class="goals-section">
      <view class="section-header">
        <text class="title">我的攒钱目标</text>
        <view class="btn-share" hover-class="hover-effect" bindtap="onGeneratePoster" wx:if="{{goals.length > 0}}">
          <text class="icon">📸</text>
          <text>生成海报</text>
        </view>
      </view>

      <view class="goal-list" wx:if="{{goals.length > 0}}">
        <view wx:for="{{goals}}" wx:key="id" class="goal-card {{item.completed ? 'completed' : ''}}" hover-class="hover-effect">
          <view class="goal-completed-badge" wx:if="{{item.completed}}">✓ 已完成</view>
          <view class="goal-shell">
            <view class="goal-left" style="background: {{item.color}};">
              <text class="goal-emoji">{{item.icon}}</text>
            </view>
            <view class="goal-right">
              <view class="goal-top">
                <view class="goal-heading">
                  <text class="goal-name">{{item.name}}</text>
                  <view class="goal-mode-badge">{{item.modeName}}</view>
                </view>
                <text class="goal-percent" style="color: {{item.progressColor}}">{{item.percent}}%</text>
              </view>
              <view class="goal-mid">
                <view class="g-progress-bg">
                  <view class="g-progress-fill" style="width: {{item.percent}}%; background: {{item.progressColor}};"></view>
                </view>
              </view>
              <view class="goal-bottom">
                <view class="goal-info">
                  <text>已攒 ¥{{item.savedDisplay}}</text>
                  <text>目标 ¥{{item.targetDisplay}}</text>
                </view>
                <view class="goal-extra" wx:if="{{item.remainingDays !== null && item.remainingDays >= 0}}">
                  <text>剩余 {{item.remainingDays}} 天</text>
                </view>
              </view>
            </view>
          </view>
          <view class="goal-insight-row">
            <view class="goal-insight goal-insight-strong">{{item.actionText}}</view>
            <view class="goal-insight">{{item.milestoneText}}</view>
          </view>
          <view class="goal-script-tip" wx:if="{{item.scriptTip}}">
            <view class="goal-script-tip-text">{{item.scriptTip}}</view>
            <view class="goal-script-status">{{item.scriptStatusText}}</view>
            <view class="goal-script-share" hover-class="hover-effect" data-id="{{item.id}}" bindtap="onCopyGoalScriptShare">
              {{item.completed ? '复制达成文案' : '复制剧本进度'}}
            </view>
          </view>
          <view class="goal-actions">
            <view class="action-btn action-btn-checkin" data-id="{{item.id}}" bindtap="onTapCheckInWithGoal">
              <text>➕ 记录</text>
            </view>
            <view class="action-btn action-btn-history" data-id="{{item.id}}" bindtap="onOpenHistory">
              <text>📜 明细</text>
            </view>
            <view class="action-btn action-btn-edit" data-id="{{item.id}}" bindtap="onOpenEditGoal">
              <text>✏️ 编辑</text>
            </view>
            <view class="action-btn action-btn-delete" data-id="{{item.id}}" bindtap="onDeleteGoal">
              <text>🗑️ 删除</text>
            </view>
          </view>
        </view>
      </view>

      <view class="empty-state" wx:else>
        <view class="empty-illustration">
          <text class="empty-icon">💰</text>
        </view>
        <text class="empty-title">开始你的攒钱计划</text>
        <text class="empty-desc">创建第一个目标，一步步靠近想要的生活 ✨</text>
        <view class="empty-create-btn" hover-class="hover-effect" bindtap="onTapCreateGoal">
          <text class="empty-create-btn-text">+ 创建第一个目标</text>
        </view>
      </view>
      
      <view class="compliance-tip">
        本工具仅为攒钱记录使用，不提供任何金融理财相关服务
      </view>

      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>

  <!-- 底部创建目标按钮 -->
  <view class="bottom-bar">
    <view class="create-btn" hover-class="hover-effect" bindtap="onBottomPrimaryAction">
      <text class="create-btn-icon">{{goals.length > 0 ? '¥' : '+'}}</text>
      <text class="create-btn-text">{{goals.length > 0 ? '记录今天一笔' : '创建目标'}}</text>
    </view>
  </view>

  <!-- 打卡底部弹窗 (Bottom Sheet) -->
  <view class="popup-mask {{showCheckInPopup ? 'popup-mask-show' : ''}}" bindtap="onClosePopup"></view>
  
  <view class="popup-content popup-content-checkin {{showCheckInPopup ? 'popup-content-show' : ''}}">
    <view class="popup-header">
      <text class="popup-title">记录一笔攒钱</text>
      <view class="popup-close" bindtap="onClosePopup">✕</view>
    </view>

    <scroll-view scroll-y class="checkin-popup-scroll" show-scrollbar="false">
      <!-- 目标选择区 -->
      <scroll-view scroll-x class="goal-selector" show-scrollbar="false">
        <view
          wx:for="{{goals}}"
          wx:key="id"
          class="goal-pill {{selectedGoalId === item.id ? 'goal-pill-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectGoal"
        >
          <text class="pill-emoji">{{item.icon}}</text>
          <text class="pill-name">{{item.name}}</text>
        </view>
        <view class="goal-pill goal-pill-add" bindtap="onTapCreateGoal">
          <text class="pill-name">+ 新目标</text>
        </view>
      </scroll-view>

      <view class="checkin-plan-tip" wx:if="{{selectedGoalId}}">
        <view class="checkin-plan-copy">
          <text class="checkin-plan-title">{{selectedGoalHint}}</text>
          <text class="checkin-plan-sub">今天已存 ¥{{selectedGoalTodayAddedDisplay}}，想跟着计划走可以直接用建议金额。</text>
        </view>
        <view class="checkin-plan-btn" hover-class="hover-effect" bindtap="onUseSuggestedAmount">
          <text>填入 ¥{{selectedGoalSuggestedAmountDisplay}}</text>
        </view>
      </view>

      <view class="checkin-note-card">
        <view class="checkin-note-header">
          <text class="checkin-note-title">给这笔钱留一句话</text>
          <text class="checkin-note-desc">选填，但很适合以后回来翻</text>
        </view>
        <view class="mood-tag-list">
          <view
            wx:for="{{moodTags}}"
            wx:key="key"
            class="mood-tag {{selectedMoodKey === item.key ? 'mood-tag-active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onSelectMoodTag"
          >
            <text>{{item.emoji}}</text>
            <text>{{item.label}}</text>
          </view>
        </view>
        <view class="note-template-list">
          <view
            wx:for="{{noteTemplates}}"
            wx:key="*this"
            class="note-template-chip"
            data-note="{{item}}"
            bindtap="onUseNoteTemplate"
          >
            <text>{{item}}</text>
          </view>
        </view>
        <input
          class="note-input"
          maxlength="30"
          placeholder="比如：今天少点一杯奶茶，先为旅行基金存起来"
          value="{{inputNote}}"
          bindinput="onInputNote"
        />
      </view>

      <!-- 快捷金额按钮 -->
      <view class="quick-amounts">
        <view
          wx:for="{{quickAmounts}}"
          wx:key="*this"
          class="quick-amount-btn"
          hover-class="quick-amount-hover"
          data-amount="{{item}}"
          bindtap="onQuickAmount"
        >
          ¥{{item}}
        </view>
      </view>

      <!-- 金额输入显示区 -->
      <view class="amount-display">
        <text class="currency-symbol">¥</text>
        <text class="amount-value {{inputAmount === '0' ? 'amount-placeholder' : ''}}">{{inputAmount}}</text>
      </view>

      <!-- 高颜值数字键盘 -->
      <view class="keyboard-area">
        <view class="keyboard-grid">
          <view
            wx:for="{{keyboardNum}}"
            wx:key="*this"
            class="key-btn"
            hover-class="key-btn-hover"
            data-key="{{item}}"
            bindtap="onTapKey"
          >
            {{item}}
          </view>
        </view>
        <view class="keyboard-action">
          <view class="action-btn-date">今天 ▼</view>
          <view class="action-btn-share" hover-class="hover-effect" bindtap="onGeneratePoster">海报</view>
          <view class="action-btn-confirm" hover-class="hover-effect" bindtap="onConfirmCheckIn">打卡</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 创建目标弹窗 -->
  <view class="popup-mask {{showCreateGoalPopup ? 'popup-mask-show' : ''}}" bindtap="onCloseCreateGoal"></view>
  
  <view class="popup-content popup-content-create {{showCreateGoalPopup ? 'popup-content-show' : ''}}">
    <view class="popup-header">
      <text class="popup-title">创建新目标</text>
      <view class="popup-close" bindtap="onCloseCreateGoal">✕</view>
    </view>

    <view class="create-form">
      <view class="form-item">
        <text class="form-label">攒钱方式</text>
        <view class="goal-mode-list">
          <view
            wx:for="{{goalModes}}"
            wx:key="key"
            class="goal-mode-card {{createGoalMode === item.key ? 'goal-mode-card-active' : ''}}"
            data-mode="{{item.key}}"
            bindtap="onSelectCreateGoalMode"
          >
            <text class="goal-mode-name">{{item.name}}</text>
            <text class="goal-mode-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">目标名称</text>
        <input 
          class="form-input" 
          placeholder="比如：旅行基金" 
          value="{{createGoalName}}"
          bindinput="onInputGoalName"
        />
      </view>

      <view class="form-item">
        <text class="form-label">目标金额 (元)</text>
        <input 
          class="form-input" 
          type="number" 
          placeholder="请输入目标金额" 
          value="{{createGoalTarget}}"
          bindinput="onInputGoalTarget"
        />
      </view>

      <view class="form-item">
        <text class="form-label">截止日期</text>
        <picker 
          mode="date" 
          value="{{createGoalDeadline}}" 
          bindchange="onDateChange"
          start="{{today}}"
        >
          <view class="form-picker">
            {{createGoalDeadline}}
          </view>
        </picker>
      </view>
    </view>

    <view class="create-helper-text">
      <text wx:if="{{createGoalScriptTip}}">{{createGoalScriptTip}}</text>
      <text wx:else>建议先定一个能坚持 30 天以上的小目标，开始比完美更重要。</text>
    </view>

    <view class="popup-actions">
      <view class="action-btn action-btn-cancel" hover-class="hover-effect" bindtap="onCloseCreateGoal">取消</view>
      <view class="action-btn action-btn-confirm-create" hover-class="hover-effect" bindtap="onConfirmCreateGoal">确认创建</view>
    </view>
  </view>

  <!-- 成就弹窗 -->
  <view class="popup-mask {{showAchievementsPopup ? 'popup-mask-show' : ''}}" bindtap="onCloseAchievements"></view>
  
  <view class="popup-content popup-content-achievements {{showAchievementsPopup ? 'popup-content-show' : ''}}">
    <view class="popup-header">
      <text class="popup-title">我的成就 🏆</text>
      <view class="popup-close" bindtap="onCloseAchievements">✕</view>
    </view>

    <view class="achievements-list">
      <view 
        wx:for="{{achievementList}}" 
        wx:key="key" 
        class="achievement-item {{achievements[item.key] ? 'achievement-unlocked' : 'achievement-locked'}}"
      >
        <view class="achievement-icon">{{item.icon}}</view>
        <view class="achievement-info">
          <text class="achievement-name">{{item.name}}</text>
          <text class="achievement-desc">{{item.desc}}</text>
        </view>
        <view class="achievement-status">
          <text wx:if="{{achievements[item.key]}}">✅ 已解锁</text>
          <text wx:else>🔒 未解锁</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 编辑目标弹窗 -->
  <view class="popup-mask {{showEditGoalPopup ? 'popup-mask-show' : ''}}" bindtap="onCloseEditGoal"></view>
  
  <view class="popup-content popup-content-create {{showEditGoalPopup ? 'popup-content-show' : ''}}">
    <view class="popup-header">
      <text class="popup-title">编辑目标</text>
      <view class="popup-close" bindtap="onCloseEditGoal">✕</view>
    </view>

    <view class="create-form">
      <view class="form-item">
        <text class="form-label">目标名称</text>
        <input 
          class="form-input" 
          placeholder="比如：旅行基金" 
          value="{{editGoalName}}"
          bindinput="onInputEditName"
        />
      </view>

      <view class="form-item">
        <text class="form-label">目标金额 (元)</text>
        <input 
          class="form-input" 
          type="number" 
          placeholder="请输入目标金额" 
          value="{{editGoalTarget}}"
          bindinput="onInputEditTarget"
        />
      </view>

      <view class="form-item">
        <text class="form-label">截止日期</text>
        <picker 
          mode="date" 
          value="{{editGoalDeadline}}" 
          bindchange="onEditDateChange"
          start="{{today}}"
        >
          <view class="form-picker">
            {{editGoalDeadline}}
          </view>
        </picker>
      </view>
    </view>

    <view class="popup-actions">
      <view class="action-btn action-btn-cancel" hover-class="hover-effect" bindtap="onCloseEditGoal">取消</view>
      <view class="action-btn action-btn-confirm-create" hover-class="hover-effect" bindtap="onConfirmEditGoal">保存修改</view>
    </view>
  </view>

  <!-- 历史记录弹窗 -->
  <view class="popup-mask {{showHistoryPopup ? 'popup-mask-show' : ''}}" bindtap="onCloseHistory"></view>
  
  <view class="popup-content popup-content-history {{showHistoryPopup ? 'popup-content-show' : ''}}">
    <view class="popup-header">
      <text class="popup-title">打卡记录</text>
      <view class="popup-close" bindtap="onCloseHistory">✕</view>
    </view>

    <view class="history-list">
      <view wx:for="{{currentGoalHistory}}" wx:key="index" class="history-item">
        <view class="history-info">
          <text class="history-date">{{item.date}}</text>
          <text class="history-mood" wx:if="{{item.moodLabel}}">{{item.moodEmoji}} {{item.moodLabel}}</text>
          <text class="history-note" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
        <text class="history-amount">+ ¥{{item.amount}}</text>
      </view>
      <view class="empty-history" wx:if="{{currentGoalHistory.length === 0}}">
        <text>暂无记录</text>
      </view>
    </view>
  </view>

  <!-- 备份弹窗 -->
  <view class="popup-mask {{showBackupPopup ? 'popup-mask-show' : ''}}" bindtap="onCloseBackup"></view>

  <view class="popup-content popup-content-backup {{showBackupPopup ? 'popup-content-show' : ''}}">
    <view class="popup-header">
      <text class="popup-title">本地备份与恢复</text>
      <view class="popup-close" bindtap="onCloseBackup">✕</view>
    </view>

    <view class="backup-body">
      <view class="backup-tip">
        数据仍然只保存在本地。这里提供一个可复制的备份内容，适合换手机或清缓存前保存。
      </view>

      <view class="backup-block">
        <text class="backup-label">备份内容</text>
        <textarea class="backup-textarea" value="{{backupPayload}}" disabled />
        <view class="backup-primary-btn" hover-class="hover-effect" bindtap="onCopyBackup">
          <text>复制备份内容</text>
        </view>
      </view>

      <view class="backup-block">
        <text class="backup-label">恢复内容</text>
        <textarea
          class="backup-textarea"
          placeholder="把之前复制的备份内容粘贴到这里"
          value="{{backupInput}}"
          bindinput="onInputBackupRestore"
        />
        <view class="backup-secondary-btn" hover-class="hover-effect" bindtap="onRestoreBackup">
          <text>恢复到当前小程序</text>
        </view>
      </view>
    </view>
  </view>

  <canvas
    canvas-id="posterCanvas"
    class="poster-canvas"
    style="width: {{posterWidth}}px; height: {{posterHeight}}px;"
  ></canvas>

  <!-- 庆祝动画弹窗 -->
  <view class="celebration-overlay {{showCelebration ? 'celebration-show' : ''}}" bindtap="closeCelebration">
    <view class="celebration-content">
      <view class="celebration-icon">🎉</view>
      <text class="celebration-title">目标达成!</text>
      <text class="celebration-desc">恭喜你完成了「{{celebrationGoalName}}」</text>
      <text class="celebration-sub">继续加油，下一个目标在等着你 ✨</text>
      <view class="celebration-btn" hover-class="hover-effect" bindtap="closeCelebration">
        <text>知道啦</text>
      </view>
    </view>
  </view>

</view>
