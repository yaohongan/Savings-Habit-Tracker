/**index.wxss**/
.page-container {
  height: 100vh;
  position: relative;
  background: linear-gradient(180deg, #FAF4EC 0%, #F5F0E8 36%, #F3F5F8 100%);
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 760rpx;
  background: linear-gradient(180deg, #F5EBDD 0%, #EAF6F1 46%, rgba(243, 245, 248, 0) 100%);
  z-index: 0;
  overflow: hidden;
}

.bg-circle-1 {
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(47, 174, 152, 0.55);
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.72;
}

.bg-circle-2 {
  position: absolute;
  top: 100rpx;
  left: -150rpx;
  width: 500rpx;
  height: 500rpx;
  background: rgba(240, 138, 93, 0.32);
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.52;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 48px;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  z-index: 100;
  backdrop-filter: blur(14px);
}

.nav-title {
  flex: 1;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--primary-strong);
  letter-spacing: 3rpx;
}

.nav-buttons {
  display: flex;
  gap: 20rpx;
}

.nav-btn {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.52);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 12rpx 30rpx rgba(34, 49, 63, 0.08);
}

.nav-btn-icon {
  font-size: 32rpx;
}

.main-scroll {
  height: 100%;
  position: relative;
  z-index: 10;
}

/* 顶部资产区 */
.asset-hero {
  padding: 70rpx 40rpx 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.asset-subtitle {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 22rpx;
}

.tag-badge {
  background: rgba(255, 255, 255, 0.64);
  padding: 8rpx 18rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  color: var(--primary);
  margin-left: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.76);
  backdrop-filter: blur(10px);
}

.asset-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 30rpx;
}

.symbol {
  font-size: 48rpx;
  font-weight: 600;
  color: #5A4A42;
  margin-right: 12rpx;
}

.number {
  font-size: 108rpx;
  font-weight: 800;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  color: #21323E;
  text-shadow: 0 8rpx 28rpx rgba(255, 255, 255, 0.82);
}

.asset-progress {
  width: 100%;
  max-width: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  border: 1px solid rgba(255,255,255,0.82);
}

.progress-fill {
  height: 100%;
  background: var(--primary-gradient);
  border-radius: 10rpx;
  transition: width 0.8s ease;
}

.progress-txt {
  font-size: 24rpx;
  color: #8A7A72;
}

/* 悬浮数据卡片 */
.stats-floating-card {
  margin: -60rpx 40rpx 40rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  border-radius: 44rpx;
  padding: 40rpx 0;
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  box-shadow: var(--card-shadow);
  border: 2rpx solid rgba(255, 255, 255, 0.66);
}

.stat-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 42rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', sans-serif;
  color: var(--primary-strong);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-sub);
}

.divider {
  width: 2rpx;
  height: 50rpx;
  background: rgba(163, 150, 146, 0.2);
}

.daily-focus-card {
  margin: 0 40rpx 36rpx;
  padding: 38rpx 34rpx;
  border-radius: 42rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.94) 0%, rgba(235, 245, 242, 0.86) 100%);
  box-shadow: 0 24rpx 64rpx rgba(31, 71, 85, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  position: relative;
  overflow: hidden;
}

.daily-focus-glow {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  right: -120rpx;
  top: -120rpx;
  border-radius: 50%;
  background: rgba(240, 138, 93, 0.18);
  filter: blur(18px);
}

.daily-focus-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.daily-focus-tag {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  color: var(--primary-strong);
  background: rgba(30, 127, 116, 0.12);
  margin-bottom: 14rpx;
}

.daily-focus-title {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-main);
}

.daily-focus-percent {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--primary);
  font-family: 'DIN Alternate', sans-serif;
}

.daily-focus-progress {
  height: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.daily-focus-progress-fill {
  height: 100%;
  background: var(--primary-gradient);
  border-radius: inherit;
}

.daily-focus-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.daily-focus-metric {
  flex: 1;
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.7);
}

.daily-focus-num {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 8rpx;
  font-family: 'DIN Alternate', sans-serif;
}

.daily-focus-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-sub);
}

.daily-focus-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.daily-focus-tip {
  font-size: 26rpx;
  line-height: 1.6;
  color: #324958;
  margin-bottom: 14rpx;
}

.daily-focus-milestone {
  font-size: 24rpx;
  color: var(--accent);
  margin-bottom: 24rpx;
}

.daily-focus-action {
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1E7F74 0%, #37A996 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 36rpx rgba(30, 127, 116, 0.26);
}

.challenge-card {
  margin: 0 40rpx 36rpx;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 44rpx;
  background: linear-gradient(145deg, #143D3A 0%, #1D7369 52%, #F08A5D 150%);
  box-shadow: 0 30rpx 72rpx rgba(20, 61, 58, 0.24);
  position: relative;
  overflow: hidden;
}

.challenge-orbit {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.13);
  pointer-events: none;
}

.challenge-orbit-a {
  width: 360rpx;
  height: 360rpx;
  right: -150rpx;
  top: -160rpx;
}

.challenge-orbit-b {
  width: 520rpx;
  height: 520rpx;
  left: -260rpx;
  bottom: -300rpx;
}

.challenge-header,
.challenge-hero-row,
.challenge-progress,
.challenge-wall,
.challenge-stats,
.challenge-status,
.challenge-actions {
  position: relative;
  z-index: 2;
}

.challenge-header {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.challenge-kicker {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.13);
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  margin-bottom: 14rpx;
}

.challenge-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.25;
}

.challenge-today-badge {
  flex-shrink: 0;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.84);
  font-size: 22rpx;
  font-weight: 700;
}

.challenge-today-done {
  background: rgba(255, 255, 255, 0.9);
  color: #14685F;
}

.challenge-hero-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 28rpx;
  margin-bottom: 22rpx;
}

.challenge-number-block {
  display: flex;
  align-items: baseline;
}

.challenge-big-number {
  font-size: 86rpx;
  font-weight: 900;
  color: #FFFFFF;
  font-family: 'DIN Alternate', sans-serif;
  letter-spacing: -2rpx;
}

.challenge-number-unit {
  margin-left: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
}

.challenge-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  text-align: right;
  font-size: 23rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.78);
}

.challenge-progress {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  overflow: hidden;
  margin-bottom: 26rpx;
}

.challenge-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #FFE2C5 0%, #FFFFFF 100%);
}

.challenge-wall {
  display: grid;
  grid-template-columns: repeat(21, 1fr);
  gap: 7rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.10);
  border: 1px solid rgba(255, 255, 255, 0.16);
  margin-bottom: 24rpx;
}

.challenge-dot {
  width: 100%;
  padding-bottom: 100%;
  border-radius: 7rpx;
  background: rgba(255, 255, 255, 0.16);
}

.challenge-dot-future {
  background: rgba(255, 255, 255, 0.10);
}

.challenge-level-1 {
  background: rgba(255, 226, 197, 0.68);
}

.challenge-level-2 {
  background: #FFD0A7;
}

.challenge-level-3 {
  background: #FFFFFF;
  box-shadow: 0 0 14rpx rgba(255, 255, 255, 0.38);
}

.challenge-dot-today {
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.30);
}

.challenge-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.challenge-stat {
  padding: 20rpx 14rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
  text-align: center;
}

.challenge-stat-num {
  display: block;
  font-size: 27rpx;
  font-weight: 800;
  color: #FFFFFF;
  font-family: 'DIN Alternate', sans-serif;
  margin-bottom: 6rpx;
}

.challenge-stat-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.68);
}

.challenge-status {
  font-size: 25rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.82);
  margin-bottom: 24rpx;
}

.challenge-actions {
  display: flex;
  gap: 16rpx;
}

.challenge-action {
  flex: 1;
  height: 82rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 800;
}

.challenge-action-primary {
  background: #FFFFFF;
  color: #14685F;
}

.challenge-action-secondary {
  background: rgba(255, 255, 255, 0.13);
  color: #FFFFFF;
  border: 1px solid rgba(255, 255, 255, 0.16);
}

.review-entry-card {
  margin: 0 40rpx 34rpx;
  padding: 28rpx 30rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 2rpx solid rgba(255, 255, 255, 0.68);
  box-shadow: 0 18rpx 42rpx rgba(34, 49, 63, 0.08);
  backdrop-filter: blur(18px);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 22rpx;
}

.review-entry-left {
  flex: 1;
}

.review-entry-kicker {
  display: inline-flex;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(30, 127, 116, 0.10);
  color: var(--primary-strong);
  font-size: 21rpx;
  margin-bottom: 12rpx;
}

.review-entry-title {
  font-size: 31rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.review-entry-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-sub);
}

.review-entry-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.review-mini-stat {
  min-width: 112rpx;
  padding: 16rpx 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(30, 127, 116, 0.10) 0%, rgba(240, 138, 93, 0.12) 100%);
  text-align: center;
}

.review-mini-num {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: var(--primary-strong);
  font-family: 'DIN Alternate', sans-serif;
}

.review-mini-label {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  color: var(--text-sub);
}

.review-toggle-icon {
  min-width: 72rpx;
  height: 52rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(34, 49, 63, 0.06);
  color: #49616F;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
}

.review-panel {
  display: block;
}

.share-kit-card {
  margin: 0 40rpx 34rpx;
  padding: 34rpx 32rpx;
  border-radius: 38rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.86) 0%, rgba(252, 247, 241, 0.96) 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  box-shadow: var(--card-shadow);
}

.share-kit-header {
  margin-bottom: 22rpx;
}

.share-kit-tag {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(240, 138, 93, 0.12);
  color: #B25E38;
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.share-kit-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-main);
}

.share-kit-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.share-kit-item {
  min-height: 168rpx;
  padding: 18rpx 14rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
}

.share-kit-icon {
  font-size: 34rpx;
  margin-bottom: 10rpx;
}

.share-kit-name {
  font-size: 23rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.share-kit-desc {
  font-size: 19rpx;
  line-height: 1.35;
  color: var(--text-sub);
}

.poster-theme-box {
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.62);
  margin-bottom: 22rpx;
}

.poster-theme-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.poster-theme-head text {
  font-size: 27rpx;
  font-weight: 800;
  color: var(--text-main);
}

.poster-theme-generate {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1E7F74 0%, #37A996 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
}

.poster-theme-list {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.poster-theme-chip {
  flex-shrink: 0;
  min-width: 172rpx;
  padding: 16rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(34, 49, 63, 0.06);
  border: 2rpx solid transparent;
}

.poster-theme-chip-active {
  background: rgba(30, 127, 116, 0.10);
  border-color: rgba(30, 127, 116, 0.28);
}

.poster-theme-name {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 6rpx;
}

.poster-theme-desc {
  display: block;
  font-size: 20rpx;
  color: var(--text-sub);
}

.weekly-report-card {
  padding: 26rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(30, 127, 116, 0.08);
}

.weekly-report-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.weekly-report-kicker {
  display: inline-flex;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(30, 127, 116, 0.12);
  color: var(--primary-strong);
  font-size: 21rpx;
  margin-bottom: 10rpx;
}

.weekly-report-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
}

.weekly-report-mood {
  flex-shrink: 0;
  align-self: flex-start;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #49616F;
  font-size: 22rpx;
  font-weight: 800;
}

.weekly-report-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.weekly-report-stats view {
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.64);
  text-align: center;
}

.weekly-report-num {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--primary-strong);
  font-family: 'DIN Alternate', sans-serif;
  margin-bottom: 6rpx;
}

.weekly-report-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-sub);
}

.weekly-report-focus {
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #49616F;
  font-size: 23rpx;
  margin-bottom: 14rpx;
}

.weekly-report-insight {
  font-size: 25rpx;
  line-height: 1.55;
  color: #324958;
}

.rhythm-card {
  margin: 0 40rpx 34rpx;
  padding: 34rpx 32rpx;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: var(--card-shadow);
  backdrop-filter: blur(18px);
}

.rhythm-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.rhythm-tag {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(34, 49, 63, 0.06);
  color: var(--text-sub);
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.rhythm-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.rhythm-summary {
  min-width: 126rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(30, 127, 116, 0.12) 0%, rgba(240, 138, 93, 0.14) 100%);
  text-align: center;
}

.rhythm-summary-num {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--primary-strong);
  font-family: 'DIN Alternate', sans-serif;
}

.rhythm-summary-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-sub);
}

.rhythm-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.rhythm-cell {
  height: 74rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(34, 49, 63, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.68);
}

.rhythm-cell-label {
  font-size: 22rpx;
  font-weight: 700;
