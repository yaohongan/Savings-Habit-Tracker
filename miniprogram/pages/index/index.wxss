/**index.wxss**/
.page-container {
  height: 100vh;
  position: relative;
  background: #F4F6F9;
}

/* 顶部极光氛围背景 - 莫兰迪中性色 */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 600rpx;
  background: linear-gradient(180deg, #E8F8F5 0%, #EBF5FB 50%, #F4F6F9 100%);
  z-index: 0;
  overflow: hidden;
}

.bg-circle-1 {
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: #A3E4D7;
  border-radius: 50%;
  filter: blur(60px);
  opacity: 0.5;
}

.bg-circle-2 {
  position: absolute;
  top: 100rpx;
  left: -150rpx;
  width: 500rpx;
  height: 500rpx;
  background: #AED6F1;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.4;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  z-index: 100;
}

.nav-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #5A4A42;
  letter-spacing: 2rpx;
}

.nav-buttons {
  display: flex;
  gap: 20rpx;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
}

.nav-btn-icon {
  font-size: 32rpx;
}

.main-scroll {
  height: 100%;
  position: relative;
  z-index: 10;
}

/* 顶部资产区 */
.asset-hero {
  padding: 60rpx 40rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.asset-subtitle {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #8A7A72;
  margin-bottom: 20rpx;
}

.tag-badge {
  background: rgba(255, 255, 255, 0.6);
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  color: var(--primary);
  margin-left: 16rpx;
  border: 1px solid #FFF;
}

.asset-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 30rpx;
}

.symbol {
  font-size: 48rpx;
  font-weight: 600;
  color: #5A4A42;
  margin-right: 12rpx;
}

.number {
  font-size: 100rpx;
  font-weight: 800;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  color: #5A4A42;
  text-shadow: 0 4rpx 20rpx rgba(255, 255, 255, 0.8);
}

.asset-progress {
  width: 100%;
  max-width: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.progress-track {
  width: 100%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  border: 1px solid rgba(255,255,255,0.8);
}

.progress-fill {
  height: 100%;
  background: var(--primary-gradient);
  border-radius: 10rpx;
  transition: width 0.8s ease;
}

.progress-txt {
  font-size: 24rpx;
  color: #8A7A72;
}

/* 悬浮数据卡片 */
.stats-floating-card {
  margin: -60rpx 40rpx 40rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  border-radius: 40rpx;
  padding: 40rpx 0;
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(255, 126, 121, 0.1);
  border: 2rpx solid #FFFFFF;
}

.stat-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', sans-serif;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #A39692;
}

.divider {
  width: 2rpx;
  height: 50rpx;
  background: rgba(163, 150, 146, 0.2);
}

/* 攒钱目标区 */
.goals-section {
  padding: 0 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #5A4A42;
}

.btn-share {
  background: var(--primary-light);
  color: var(--primary);
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.icon {
  margin-right: 8rpx;
}

/* 目标票根卡片 */
.goal-ticket {
  display: flex;
  background: #FFFFFF;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.03);
}

.ticket-left {
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.ticket-emoji {
  font-size: 60rpx;
}

.ticket-right {
  flex: 1;
  padding: 30rpx 40rpx;
}

.ticket-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.ticket-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #5A4A42;
}

.ticket-percent {
  font-size: 30rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', sans-serif;
}

.t-progress-bg {
  height: 10rpx;
  background: #F2F2F2;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
}

.t-progress-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.6s ease;
}

.ticket-bottom {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #A39692;
}

.bottom-spacer {
  height: 200rpx;
}

/* 悬浮按钮 */
.fab-wrapper {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  pointer-events: none;
  z-index: 99;
}

.fab-button {
  pointer-events: auto;
  background: var(--primary-gradient);
  color: #FFF;
  padding: 28rpx 60rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--card-shadow);
}

.fab-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.fab-text {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ================= 底部弹窗 (Bottom Sheet) ================= */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 900;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  backdrop-filter: blur(4px);
}

.popup-mask-show {
  opacity: 1;
  pointer-events: auto;
}

.popup-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #F7F8FA;
  border-radius: 48rpx 48rpx 0 0;
  z-index: 999;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  padding-bottom: env(safe-area-inset-bottom);
}

.popup-content-show {
  transform: translateY(0);
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.1);
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx 20rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.popup-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

/* 目标选择区 (横向滚动) */
.goal-selector {
  width: 100%;
  white-space: nowrap;
  padding: 10rpx 0 30rpx;
}

.goal-pill {
  display: inline-flex;
  align-items: center;
  background: #FFF;
  padding: 16rpx 32rpx;
  border-radius: 100rpx;
  margin-left: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.goal-pill:first-child {
  margin-left: 40rpx;
}

.goal-pill:last-child {
  margin-right: 40rpx;
}

.goal-pill-active {
  border-color: var(--primary);
  background: var(--primary-light);
}

.pill-emoji {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.pill-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.goal-pill-add {
  background: transparent;
  border: 2rpx dashed #CCC;
  box-shadow: none;
}
.goal-pill-add .pill-name {
  color: #888;
}

/* 金额显示区 */
.amount-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 40rpx 40rpx 60rpx;
}

.currency-symbol {
  font-size: 56rpx;
  font-weight: 600;
  color: #222;
  margin-right: 12rpx;
}

.amount-value {
  font-size: 100rpx;
  font-weight: 800;
  font-family: 'DIN Alternate', sans-serif;
  color: #222;
}

.amount-placeholder {
  color: #CCC;
}

/* 键盘区域 */
.keyboard-area {
  background: #FFF;
  padding: 40rpx;
  border-radius: 48rpx 48rpx 0 0;
  display: flex;
}

.keyboard-grid {
  flex: 3;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-right: 20rpx;
}

.key-btn {
  background: #F7F8FA;
  border-radius: 24rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  font-family: 'DIN Alternate', sans-serif;
  color: #333;
  box-shadow: 0 4rpx 0 #EAEAEA;
}

.key-btn-hover {
  background: #EAEAEA;
  transform: translateY(4rpx);
  box-shadow: none;
}

.keyboard-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn-date {
  background: #F7F8FA;
  border-radius: 24rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  box-shadow: 0 4rpx 0 #EAEAEA;
}

.action-btn-share {
  background: var(--primary-light);
  border-radius: 24rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
  box-shadow: 0 4rpx 0 #EAEAEA;
}

.action-btn-confirm {
  background: var(--primary-gradient);
  border-radius: 24rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFF;
  box-shadow: var(--card-shadow);
}

/* 海报画布 (隐藏) */
.poster-canvas {
  position: fixed;
  left: 9000px;
  top: 0;
  z-index: -1;
  opacity: 0;
  pointer-events: none;
}

/* 快捷金额按钮 */
.quick-amounts {
  display: flex;
  justify-content: space-between;
  padding: 0 40rpx 20rpx;
  gap: 16rpx;
}

.quick-amount-btn {
  flex: 1;
  background: #FFF;
  border: 2rpx solid #EAEAEA;
  border-radius: 16rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #5A4A42;
}

.quick-amount-hover {
  background: var(--primary-light);
  border-color: var(--primary);
  color: var(--primary);
}

/* 热门目标一键添加 */
.hot-goals-section {
  margin: 0 0 40rpx;
  padding: 0 16rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
  padding-left: 10rpx;
}

.hot-goals-scroll {
  width: 100%;
  white-space: nowrap;
}

.hot-goal-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  margin-left: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  border: 2rpx solid transparent;
}

.hot-goal-card:first-child {
  margin-left: 0;
}

.hot-goal-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.hot-goal-name {
  font-size: 24rpx;
  color: #5A4A42;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx 120rpx;
  color: #999;
}

.empty-illustration {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8F8F5 0%, #EBF5FB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(72, 201, 176, 0.15);
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #5A4A42;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  text-align: center;
  color: #A39692;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.empty-create-btn {
  background: linear-gradient(135deg, #FF7E79 0%, #FFA789 100%);
  padding: 24rpx 48rpx;
  border-radius: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 126, 121, 0.3);
}

.empty-create-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFF;
  letter-spacing: 1rpx;
}

/* 目标卡片 */
.goal-list {
  margin-bottom: 40rpx;
}

.goal-card {
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.05);
}

.goal-main {
  display: flex;
  padding: 20rpx;
}

.goal-left {
  width: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.goal-emoji {
  font-size: 48rpx;
}

.goal-right {
  flex: 1;
  padding: 0 20rpx;
}

.goal-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.goal-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #5A4A42;
}

.goal-percent {
  font-size: 28rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', sans-serif;
}

.goal-mid {
  margin-bottom: 16rpx;
}

.g-progress-bg {
  height: 12rpx;
  background: #F2F2F2;
  border-radius: 6rpx;
  overflow: hidden;
}

.g-progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.6s ease;
}

.goal-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goal-info {
  display: flex;
  gap: 32rpx;
  font-size: 26rpx;
  color: #A39692;
}

.goal-extra {
  font-size: 24rpx;
  color: #FF7E79;
  font-weight: 500;
}

.goal-actions {
  display: flex;
  border-top: 1rpx solid #F0F0F0;
}

.action-btn {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn-checkin {
  color: #48C9B0;
  background: #F8FFF9;
}

.action-btn-delete {
  color: #FF7E79;
  background: #FFF5F5;
}

.action-btn-history {
  color: #5DADE2;
  background: #EBF5FB;
}

.action-btn-edit {
  color: #48C9B0;
  background: #E8F8F5;
}

/* 金融合规提示 */
.compliance-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding: 30rpx 0;
  line-height: 1.4;
}

/* 底部创建目标栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #F4F6F9;
  z-index: 99;
}

.create-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF7E79 0%, #FFA789 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 126, 121, 0.3);
}

.create-btn-icon {
  font-size: 36rpx;
  color: #FFF;
  font-weight: 700;
  margin-right: 12rpx;
  line-height: 1;
}

.create-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFF;
  letter-spacing: 2rpx;
}

/* 创建目标表单 */
.create-form {
  padding: 20rpx 40rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #FFF;
  border: 2rpx solid #EAEAEA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  background: #FFF;
  border: 2rpx solid #EAEAEA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  line-height: 76rpx;
  box-sizing: border-box;
  color: #333;
}

.popup-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 40rpx 40rpx;
}

.popup-actions .action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.action-btn-cancel {
  background: #F5F5F5;
  color: #666;
}

.action-btn-confirm-create {
  background: linear-gradient(135deg, #FF7E79 0%, #FFA789 100%);
  color: #FFF;
}

/* 成就列表 */
.achievements-list {
  padding: 20rpx 20rpx 40rpx;
  max-height: 800rpx;
}

.achievement-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #F8F8F8;
}

.achievement-item.achievement-unlocked {
  background: rgba(72, 201, 176, 0.1);
  border: 2rpx solid rgba(72, 201, 176, 0.3);
}

.achievement-item.achievement-locked {
  opacity: 0.5;
}

.achievement-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  width: 60rpx;
  text-align: center;
}

.achievement-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.achievement-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.achievement-desc {
  font-size: 24rpx;
  color: #999;
}

.achievement-status {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
}

.bottom-spacer {
  height: 180rpx;
}

/* 历史记录列表 */
.history-list {
  padding: 0 20rpx 40rpx;
  max-height: 600rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 20rpx;
  margin-bottom: 12rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
}

.history-info {
  display: flex;
  flex-direction: column;
}

.history-date {
  font-size: 26rpx;
  color: #666;
}

.history-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #48C9B0;
}

.empty-history {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 已完成目标标记 */
.goal-card.completed {
  opacity: 0.7;
  border: 2rpx solid #FFD700;
}

.goal-completed-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFF;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
}

/* 庆祝动画弹窗 */
.celebration-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.celebration-overlay.celebration-show {
  opacity: 1;
  pointer-events: auto;
}

.celebration-content {
  background: linear-gradient(135deg, #FFF 0%, #FDFBF7 100%);
  border-radius: 40rpx;
  padding: 80rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 80rpx rgba(255, 126, 121, 0.2);
  animation: celebrationBounce 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes celebrationBounce {
  0% {
    transform: scale(0.5);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.celebration-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  animation: celebrationIcon 1s infinite alternate;
}

@keyframes celebrationIcon {
  0% {
    transform: scale(1) rotate(-5deg);
  }
  100% {
    transform: scale(1.1) rotate(5deg);
  }
}

.celebration-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF7E79;
  margin-bottom: 16rpx;
}

.celebration-desc {
  font-size: 30rpx;
  color: #5A4A42;
  margin-bottom: 12rpx;
  text-align: center;
}

.celebration-sub {
  font-size: 26rpx;
  color: #A39692;
  margin-bottom: 40rpx;
  text-align: center;
}

.celebration-btn {
  background: linear-gradient(135deg, #FF7E79 0%, #FFA789 100%);
  padding: 24rpx 60rpx;
  border-radius: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 126, 121, 0.3);
}

.celebration-btn text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFF;
}
