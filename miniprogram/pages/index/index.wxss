  text-align: center;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.empty-create-btn {
  background: linear-gradient(135deg, #F08A5D 0%, #D86F45 100%);
  padding: 24rpx 48rpx;
  border-radius: 100rpx;
  box-shadow: 0 16rpx 32rpx rgba(216, 111, 69, 0.24);
}

.empty-create-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFF;
  letter-spacing: 1rpx;
}

/* 目标卡片 */
.goal-list {
  margin-bottom: 40rpx;
}

.goal-card {
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.80);
  border-radius: 34rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 44rpx rgba(34, 49, 63, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
}

.goal-shell {
  display: flex;
  padding: 24rpx 24rpx 18rpx;
}

.goal-left {
  width: 108rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

.goal-emoji {
  font-size: 52rpx;
}

.goal-right {
  flex: 1;
  padding: 0 0 0 20rpx;
}

.goal-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.goal-heading {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.goal-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.goal-mode-badge {
  display: inline-flex;
  align-self: flex-start;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(30, 127, 116, 0.10);
  color: var(--primary-strong);
  font-size: 20rpx;
  font-weight: 700;
}

.goal-percent {
  font-size: 30rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', sans-serif;
}

.goal-mid {
  margin-bottom: 16rpx;
}

.g-progress-bg {
  height: 12rpx;
  background: rgba(34, 49, 63, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
}

.g-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.6s ease;
}

.goal-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goal-info {
  display: flex;
  gap: 32rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.goal-extra {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

.goal-insight-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 0 24rpx 18rpx;
}

.goal-insight {
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #48606F;
  background: rgba(34, 49, 63, 0.05);
}

.goal-insight-strong {
  background: rgba(30, 127, 116, 0.10);
  color: var(--primary-strong);
  font-weight: 700;
}

.goal-script-tip {
  margin: 0 24rpx 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(240, 138, 93, 0.10);
  color: #8E4F33;
  font-size: 23rpx;
  line-height: 1.55;
}

.goal-script-tip-text {
  margin-bottom: 8rpx;
}

.goal-script-status {
  color: #B25E38;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.goal-script-share {
  height: 58rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.74);
  color: #8E4F33;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
}

.goal-actions {
  display: flex;
  border-top: 1rpx solid rgba(34, 49, 63, 0.06);
}

.action-btn {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.action-btn-checkin {
  color: var(--primary-strong);
  background: rgba(30, 127, 116, 0.08);
}

.action-btn-delete {
  color: #C86A43;
  background: rgba(240, 138, 93, 0.10);
}

.action-btn-history {
  color: #476B88;
  background: rgba(71, 107, 136, 0.08);
}

.action-btn-edit {
  color: var(--primary-strong);
  background: rgba(30, 127, 116, 0.06);
}

/* 金融合规提示 */
.compliance-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub);
  padding: 30rpx 0;
  line-height: 1.4;
}

/* 底部创建目标栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(243, 245, 248, 0) 0%, rgba(243, 245, 248, 0.92) 38%, rgba(243, 245, 248, 1) 100%);
  z-index: 99;
}

.create-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #F08A5D 0%, #D86F45 100%);
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 36rpx rgba(216, 111, 69, 0.26);
}

.create-btn-icon {
  font-size: 36rpx;
  color: #FFF;
  font-weight: 700;
  margin-right: 12rpx;
  line-height: 1;
}

.create-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFF;
  letter-spacing: 3rpx;
}

/* 创建目标表单 */
.create-form {
  padding: 20rpx 40rpx;
}

.goal-mode-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.goal-mode-card {
  padding: 24rpx 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 22rpx;
  border: 2rpx solid rgba(34, 49, 63, 0.06);
}

.goal-mode-card-active {
  border-color: var(--primary);
  background: rgba(30, 127, 116, 0.10);
  box-shadow: 0 12rpx 24rpx rgba(30, 127, 116, 0.10);
}

.goal-mode-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.goal-mode-desc {
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
  color: #7F8C8D;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid rgba(34, 49, 63, 0.06);
  border-radius: 18rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid rgba(34, 49, 63, 0.06);
  border-radius: 18rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  line-height: 76rpx;
  box-sizing: border-box;
  color: #333;
}

.popup-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 40rpx 40rpx;
}

.create-helper-text {
  padding: 0 40rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8A7A72;
}

.popup-actions .action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.action-btn-cancel {
  background: #EEF2F4;
  color: #5E6E7B;
}

.action-btn-confirm-create {
  background: linear-gradient(135deg, #F08A5D 0%, #D86F45 100%);
  color: #FFF;
}

/* 成就列表 */
.achievements-list {
  padding: 20rpx 20rpx 40rpx;
  max-height: 800rpx;
}

.achievement-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 10rpx 24rpx rgba(34, 49, 63, 0.04);
}

.achievement-item.achievement-unlocked {
  background: rgba(30, 127, 116, 0.10);
  border: 2rpx solid rgba(30, 127, 116, 0.24);
}

.achievement-item.achievement-locked {
  opacity: 0.5;
}

.achievement-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  width: 60rpx;
  text-align: center;
}

.achievement-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.achievement-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 4rpx;
}

.achievement-desc {
  font-size: 24rpx;
  color: var(--text-sub);
}

.achievement-status {
  font-size: 24rpx;
  color: var(--text-sub);
  white-space: nowrap;
}

.bottom-spacer {
  height: 180rpx;
}

/* 历史记录列表 */
.history-list {
  padding: 0 20rpx 40rpx;
  max-height: 600rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 20rpx;
  margin-bottom: 12rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 18rpx;
  box-shadow: 0 10rpx 20rpx rgba(34, 49, 63, 0.04);
}

.history-info {
  display: flex;
  flex-direction: column;
}

.history-date {
  font-size: 26rpx;
  color: var(--text-sub);
}

.history-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #49616F;
}

.history-mood {
  display: inline-flex;
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(30, 127, 116, 0.08);
  color: var(--primary-strong);
  font-size: 22rpx;
}

.history-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-strong);
}

.empty-history {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 已完成目标标记 */
.goal-card.completed {
  opacity: 0.78;
  border: 2rpx solid rgba(240, 181, 63, 0.72);
}

.goal-completed-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  background: linear-gradient(135deg, #F0B53F 0%, #E48732 100%);
  color: #FFF;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
}

/* 庆祝动画弹窗 */
.celebration-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.celebration-overlay.celebration-show {
  opacity: 1;
  pointer-events: auto;
}

.celebration-content {
  background: linear-gradient(135deg, #FFFDF9 0%, #F7F3ED 100%);
  border-radius: 40rpx;
  padding: 80rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 80rpx rgba(34, 49, 63, 0.16);
  animation: celebrationBounce 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes celebrationBounce {
  0% {
    transform: scale(0.5);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.celebration-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  animation: celebrationIcon 1s infinite alternate;
}

@keyframes celebrationIcon {
  0% {
    transform: scale(1) rotate(-5deg);
  }
  100% {
    transform: scale(1.1) rotate(5deg);
  }
}

.celebration-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 16rpx;
}

.celebration-desc {
  font-size: 30rpx;
  color: var(--text-main);
  margin-bottom: 12rpx;
  text-align: center;
}

.celebration-sub {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 40rpx;
  text-align: center;
}

.celebration-btn {
  background: linear-gradient(135deg, #F08A5D 0%, #D86F45 100%);
  padding: 24rpx 60rpx;
  border-radius: 100rpx;
  box-shadow: 0 12rpx 28rpx rgba(216, 111, 69, 0.24);
}

.celebration-btn text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFF;
}

.popup-content-backup {
  max-height: 82vh;
}

.backup-body {
  padding: 0 40rpx 40rpx;
  overflow-y: auto;
}

.backup-tip {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-sub);
  margin-bottom: 22rpx;
}

.backup-block {
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  margin-bottom: 18rpx;
}

.backup-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.backup-textarea {
  width: 100%;
  height: 220rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(250, 251, 252, 0.98);
  border: 2rpx solid rgba(34, 49, 63, 0.06);
  font-size: 22rpx;
  line-height: 1.5;
  color: #49616F;
  margin-bottom: 18rpx;
}

.backup-primary-btn,
.backup-secondary-btn {
  height: 82rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.backup-primary-btn {
  background: linear-gradient(135deg, #1E7F74 0%, #37A996 100%);
  color: #FFFFFF;
}

.backup-secondary-btn {
  background: rgba(240, 138, 93, 0.12);
  color: #B25E38;
}
