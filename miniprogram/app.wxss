/**app.wxss**/
page {
  background: #F6F1EA;
  color: #22313F;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', sans-serif;
  --primary: #1E7F74;
  --primary-strong: #14554E;
  --primary-light: rgba(30, 127, 116, 0.10);
  --primary-gradient: linear-gradient(135deg, #2FAE98 0%, #16695F 100%);
  --accent: #F08A5D;
  --accent-soft: rgba(240, 138, 93, 0.14);
  --paper: rgba(255, 255, 255, 0.86);
  --paper-strong: rgba(255, 255, 255, 0.96);
  --text-main: #22313F;
  --text-sub: #6D7A86;
  --card-border: rgba(255, 255, 255, 0.72);
  --card-shadow: 0 24rpx 60rpx rgba(31, 71, 85, 0.12);
  --soft-shadow: 0 18rpx 42rpx rgba(30, 127, 116, 0.12);
}

.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

/* 氛围光晕背景 - 中性莫兰迪色系 */
.ambient-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
  pointer-events: none;
  background: #F4F6F9;
}

.ambient-blob-1 {
  position: absolute;
  top: -10%;
  right: -20%;
  width: 600rpx;
  height: 600rpx;
  background: #E8F8F5; /* 浅薄荷绿 */
  border-radius: 50%;
  filter: blur(80px);
}

.ambient-blob-2 {
  position: absolute;
  top: 30%;
  left: -20%;
  width: 500rpx;
  height: 500rpx;
  background: #EBF5FB; /* 浅蓝白 */
  border-radius: 50%;
  filter: blur(80px);
}

.ambient-blob-3 {
  position: absolute;
  bottom: -10%;
  right: -10%;
  width: 700rpx;
  height: 700rpx;
  background: #FEF9E7; /* 治愈浅黄 */
  border-radius: 50%;
  filter: blur(100px);
}

::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.hover-effect {
  opacity: 0.8;
  transform: scale(0.98);
  transition: all 0.2s ease;
}
