/**app.wxss**/
page {
  background: #F4F6F9; /* 更中性的灰蓝色背景 */
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', sans-serif;
  --primary: #48C9B0; /* 清新薄荷绿，男女通吃 */
  --primary-light: #E8F8F5;
  --primary-gradient: linear-gradient(135deg, #A3E4D7 0%, #48C9B0 100%);
  --text-main: #2C3E50; /* 深蓝灰，比暖咖色更中性 */
  --text-sub: #7F8C8D;
  --card-bg: rgba(255, 255, 255, 0.85);
  --card-border: rgba(255, 255, 255, 0.9);
  --card-shadow: 0 16rpx 40rpx rgba(72, 201, 176, 0.1);
}

.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

/* 氛围光晕背景 - 中性莫兰迪色系 */
.ambient-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
  pointer-events: none;
  background: #F4F6F9;
}

.ambient-blob-1 {
  position: absolute;
  top: -10%;
  right: -20%;
  width: 600rpx;
  height: 600rpx;
  background: #E8F8F5; /* 浅薄荷绿 */
  border-radius: 50%;
  filter: blur(80px);
}

.ambient-blob-2 {
  position: absolute;
  top: 30%;
  left: -20%;
  width: 500rpx;
  height: 500rpx;
  background: #EBF5FB; /* 浅蓝白 */
  border-radius: 50%;
  filter: blur(80px);
}

.ambient-blob-3 {
  position: absolute;
  bottom: -10%;
  right: -10%;
  width: 700rpx;
  height: 700rpx;
  background: #FEF9E7; /* 治愈浅黄 */
  border-radius: 50%;
  filter: blur(100px);
}

::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.hover-effect {
  opacity: 0.8;
  transform: scale(0.98);
  transition: all 0.2s ease;
}
